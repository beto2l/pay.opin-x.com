# Recetario Keto - Variables de entorno del servidor
# Copia este archivo como .env y completa los valores reales.
# IMPORTANTE: .env NO debe subirse a GitHub.

STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXX
DEPLOY_SECRET=pon_aqui_un_secreto_largo_unico
SITE_PATH=/www/tu-dominio.com
GIT_BRANCH=main
GITHUB_ZIP_URL=https://github.com/beto2l/pay.opin-x.com/archive/refs/heads/main.zip
SITE_URL=https://tu-dominio.com
SUCCESS_EMAIL=ventas@recetarioketo.com

# --- Panel de administración oculto (/admin/) ---
# Usuario del panel (por defecto: admin)
ADMIN_USER=admin
# Hash de la contraseña generado con PHP:
#   php -r 'echo password_hash("TU_CONTRASENA", PASSWORD_DEFAULT);'
# Pega aquí el resultado (empieza con $2y$...).
ADMIN_PASSWORD_HASH=
# Alternativa NO recomendada: contraseña en texto plano (solo si no usas hash).
# ADMIN_PASSWORD=
