# Recetario Keto / OPIN X - Configuración Apache
# ==============================================

# Archivo de índice por defecto (PHP primero para inyectar la clave de Stripe)
DirectoryIndex index.php index.html

# Desactivar listado de directorios (no mostrar "Index of /...")
Options -Indexes

# Páginas de error personalizadas (neutras, no revelan estructura)
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php

# Activar rewrite engine
RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Si el usuario entra a /step/<slug>/ servir su index.php
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^step/[^/]+/?$ %{REQUEST_URI}index.php [L]

# ----- Redirigir TODO lo demás a la primera página -----
# Cualquier URL que NO sea una página de step, el panel /admin/, los
# archivos de /assets/ o el endpoint deploy.php se redirige (302) a la
# primera página de checkout. Así /, /nusa/, /wp-login, etc. nunca
# muestran errores ni listados: siempre llevan a recetario-keto.
RewriteCond %{REQUEST_URI} !^/step/
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !^/deploy\.php$ [NC]
RewriteRule ^ /step/recetario-keto/ [L,R=302]

# ----- Bloqueos de seguridad (por si acaso, además del redirect) -----
# La carpeta de scripts compartidos y data nunca deben servirse directo.
RedirectMatch 404 ^/scripts(/|$)
RedirectMatch 404 ^/data(/|$)
RedirectMatch 404 /\.git

# Proteger archivos sensibles por nombre
<FilesMatch "^(\.env|\.env\..*|deploy\.log|\.gitignore|\.gitkeep|README\.md|INSTRUCCIONES-DEPLOY\.txt|\.htaccess)$">
    Require all denied
</FilesMatch>

# Caché de archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Seguridad headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
