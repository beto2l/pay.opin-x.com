# Recetario Keto / OPIN X - Configuración Apache
# ==============================================

# Archivo de índice por defecto (PHP primero para inyectar la clave de Stripe)
DirectoryIndex index.php index.html

# Desactivar listado de directorios (no mostrar "Index of /...")
Options -Indexes

# Páginas de error personalizadas (neutras, no revelan estructura)
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php

# Activar rewrite engine
RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Si el usuario entra a /step/<slug>/ servir su index.php
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^step/[^/]+/?$ %{REQUEST_URI}index.php [L]

# ----- Ocultar todo lo que no sea una página pública -----
# Bloquear acceso directo a la carpeta de scripts compartidos
RedirectMatch 404 ^/scripts(/|$)
# Bloquear acceso directo a la carpeta data
RedirectMatch 404 ^/data(/|$)
# Bloquear la carpeta .git
RedirectMatch 404 /\.git
# Bloquear archivos de texto/documentación y ejemplos de configuración
RedirectMatch 404 (?i)\.(env|md|txt|log|sample|example|bak|dist|json|lock)$

# Proteger archivos sensibles por nombre
<FilesMatch "^(\.env|\.env\..*|deploy\.log|\.gitignore|\.gitkeep|README\.md|INSTRUCCIONES-DEPLOY\.txt|\.htaccess)$">
    Require all denied
</FilesMatch>

# Caché de archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Seguridad headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
